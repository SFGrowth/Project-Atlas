# .env.test.example — Atlas Nexus Test Environment Configuration
#
# Sprint 123A.10 Gate G10 — Test Environment Isolation Lock
#
# This file documents the required test environment variables.
# Copy to .env.test and adjust as needed.
# .env.test is gitignored (contains ephemeral test credentials).
# This .env.test.example is committed — it contains FAKE values only.
#
# RULES:
#   - DATABASE_URL MUST contain "test" in the schema/database name.
#   - No live API keys, staging URLs, or production credentials.
#   - All values here are fake and for documentation purposes only.

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=test

# ─── Database (MUST contain "test" in schema name) ────────────────────────────
# The test database is accessed via MySQL socket to avoid network credentials.
# atlas_test_123a3 is the approved isolated test database.
DATABASE_URL=mysql://root@localhost/atlas_test_123a3?socket=/tmp/mysql_test.sock

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=test-jwt-secret-fake-value-not-real
OAUTH_SERVER_URL=http://localhost:19999/mock-oauth
OWNER_OPEN_ID=test-owner-open-id-fake

# ─── Vite / App ───────────────────────────────────────────────────────────────
VITE_APP_ID=test-app-id-fake
VITE_OAUTH_PORTAL_URL=http://localhost:19999/mock-oauth-portal
VITE_ANALYTICS_ENDPOINT=http://localhost:19999/mock-analytics
VITE_ANALYTICS_WEBSITE_ID=test-analytics-id-fake

# ─── External Services (FAKE — no live credentials) ──────────────────────────
# Databento: fake key — tests must not contact live Databento
DATABENTO_API_KEY=db-test-fake-key-0000000000000000000000000000000000000000

# Bridge: fake token — tests must not contact live bridge
BRIDGE_AUTH_TOKEN=test-bridge-token-fake-value
BRIDGE_RAW_SYMBOL=MNQ.v.0
BRIDGE_INSTRUMENT_ID=0
BRIDGE_DATASET=GLBX.MDP3

# GitHub: fake token — tests must not contact live GitHub
ATLAS_GITHUB_TOKEN=ghp_test_fake_token_0000000000000000000000

# ─── Market Data Authority ────────────────────────────────────────────────────
MARKET_DATA_AUTHORITY=test
ATLAS_GATE_G4_CHART_AUTHORITY_ENABLED=false

# ─── Internal Forge API (sandbox-only LLM proxy) ─────────────────────────────
BUILT_IN_FORGE_API_URL=http://localhost:19999/mock-forge
BUILT_IN_FORGE_API_KEY=test-forge-key-fake
